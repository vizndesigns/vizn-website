{
  "version": 2,
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/vizn-templates", "destination": "/vizn-templates.html" },
    { "source": "/vizn-admin", "destination": "/vizn-admin.html" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "vizn-website-chi.vercel.app" }],
      "destination": "https://vizndesigns.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
